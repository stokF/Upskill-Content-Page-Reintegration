<script>
  (function () {
    var melTime = document.getElementById("melTime");
    if (melTime && window.Intl && Intl.DateTimeFormat) {
      var fmt = new Intl.DateTimeFormat("en-AU", {
        timeZone: "Australia/Melbourne",
        weekday: "short", day: "numeric", month: "short", year: "numeric"
      });
      var ymdFmt = new Intl.DateTimeFormat("en-CA", {
        timeZone: "Australia/Melbourne", year: "numeric", month: "2-digit", day: "2-digit"
      });
      var MS_DAY = 86400000;
      var WEEK_MS = 7 * MS_DAY;
      var winStart = Date.UTC(2026, 6, 6);
      var winEnd = winStart + 4 * WEEK_MS;

      var timerCount = document.getElementById("timerCount");
      var timerBar = document.getElementById("timerBar");
      var timerStatus = document.getElementById("timerStatus");
      var windowNote = document.getElementById("windowNote");
      var windowRange = document.getElementById("windowRange");
      var markButtons = Array.prototype.slice.call(document.querySelectorAll(".markpill__btn"));
      var markNote = document.getElementById("markNote");
      var tierDhd = document.getElementById("tierDhd");
      var tierDhdNote = document.getElementById("tierDhdNote");
      var reqTargetLabel = document.getElementById("reqTargetLabel");
      var splitOpt = document.querySelector(".split__cell--opt");
      var phaseOpt = document.querySelector(".phase--opt");
      var MARK_KEY = "pde-target-grade-v1";
      var GRADE_LABELS = { P: "Pass", C: "Credit", D: "Distinction", HD: "High Distinction" };
      var markFromGrade = function (grade) {
        return grade === "D" || grade === "HD" ? "dhd" : grade ? "pc" : "";
      };

      var rangeFmt = new Intl.DateTimeFormat("en-AU", { timeZone: "UTC", day: "numeric", month: "short" });
      var yearFmt = new Intl.DateTimeFormat("en-AU", { timeZone: "UTC", year: "numeric" });

      var todayUTC = function () {
        var parts = {};
        ymdFmt.formatToParts(new Date()).forEach(function (p) { parts[p.type] = p.value; });
        return Date.UTC(+parts.year, +parts.month - 1, +parts.day);
      };

      var tick = function () {
        var now = new Date();
        melTime.textContent = fmt.format(now);
        melTime.dateTime = now.toISOString();

        if (!timerCount) return;
        var today = todayUTC();
        var totalDays = (winEnd - winStart) / MS_DAY;
        var elapsedDays = Math.min(Math.max((today - winStart) / MS_DAY, 0), totalDays);
        var pct = Math.round(elapsedDays / totalDays * 100);
        timerBar.style.width = pct + "%";

        if (today < winStart) {
          var untilStart = Math.round((winStart - today) / MS_DAY);
          timerCount.textContent = untilStart + "d";
          timerCount.classList.remove("is-overdue");
          timerStatus.textContent = "Opens in " + untilStart + " day" + (untilStart === 1 ? "" : "s");
        } else if (today <= winEnd) {
          var remaining = Math.round((winEnd - today) / MS_DAY);
          timerCount.textContent = "In Progress";
          timerCount.classList.remove("is-overdue");
          timerStatus.textContent = remaining + " day" + (remaining === 1 ? "" : "s") + " remaining";
        } else {
          var overdue = Math.round((today - winEnd) / MS_DAY);
          timerCount.textContent = "Complete";
          timerCount.classList.add("is-overdue");
          timerStatus.textContent = "Window: " + overdue + " day" + (overdue === 1 ? "" : "s") + " ago";
        }
      };

      var applyMark = function (grade) {
        var mark = markFromGrade(grade);
        var weeks = mark === "dhd" ? 3 : 4;
        winEnd = winStart + weeks * WEEK_MS;
        markButtons.forEach(function (btn) {
          btn.classList.toggle("is-active", btn.dataset.grade === grade);
        });
        if (windowNote) windowNote.hidden = !grade;
        if (windowRange) {
          windowRange.textContent = grade
            ? rangeFmt.format(winStart) + " – " + rangeFmt.format(winEnd) + " " + yearFmt.format(winEnd)
            : "";
        }
        if (markNote) {
          markNote.textContent = mark === "dhd" ? "3-week window applies to your target mark."
            : mark === "pc" ? "4-week window applies to your target mark." : "";
        }
        var hideExtra = mark === "pc";
        if (tierDhd) tierDhd.hidden = hideExtra;
        if (splitOpt) splitOpt.hidden = hideExtra;
        if (phaseOpt) phaseOpt.hidden = hideExtra;
        if (reqTargetLabel) {
          reqTargetLabel.textContent = GRADE_LABELS[grade] || "";
        }
        if (tierDhdNote) {
          tierDhdNote.textContent = mark === "dhd" ? "Required for your target mark." : "";
        }
        tick();
        document.dispatchEvent(new Event("pde:recalc"));
      };

      if (markButtons.length) {
        var savedGrade = "";
        try {
          var stored = localStorage.getItem(MARK_KEY);
          if (["P", "C", "D", "HD"].indexOf(stored) !== -1) savedGrade = stored;
        } catch (e) { }

        markButtons.forEach(function (btn) {
          btn.addEventListener("click", function () {
            var grade = btn.classList.contains("is-active") ? "" : btn.dataset.grade;
            applyMark(grade);
            try { localStorage.setItem(MARK_KEY, grade); } catch (e) {}
          });
        });
        applyMark(savedGrade);
      } else {
        tick();
      }
      setInterval(tick, 60000);
    }
  })();

  (function () {
    var KEY = "pde-upskilling-v2";
    var boxes = Array.prototype.slice.call(document.querySelectorAll(".box"));
    var phases = Array.prototype.slice.call(document.querySelectorAll("[data-phase]"));

    try {
      var saved = JSON.parse(localStorage.getItem(KEY) || "null");
      if (saved && saved.length === boxes.length) {
        boxes.forEach(function (b, i) { b.checked = !!saved[i]; });
      }
    } catch (e) { }

    function pct(done, total) { return total ? Math.round(done / total * 100) : 0; }

    function fmtDuration(mins, style) {
      mins = Math.max(0, Math.round(mins));
      if (mins < 60) return (style === "long" ? "~" : "") + mins + " min";
      var h = Math.round(mins / 60 * 10) / 10;
      var hs = (h % 1 === 0) ? h.toFixed(0) : h.toFixed(1);
      return style === "long" ? ("~" + hs + " hour" + (h === 1 ? "" : "s")) : (hs + " h");
    }

    function count(scope) {
      var bs = scope.querySelectorAll(".box"), d = 0, total = 0, mins = 0;
      bs.forEach(function (b) {
        if (b.closest("[hidden]")) return;
        if (b.dataset.optional !== undefined) return;
        total++;
        if (b.checked) d++;
        else mins += Number(b.dataset.mins) || 0;
      });
      return { done: d, total: total, mins: mins };
    }

    function render() {
      phases.forEach(function (phase) {
        phase.querySelectorAll(".card").forEach(function (card) {
          var c = count(card);
          var frac = card.querySelector("[data-sec-count]");
          frac.textContent = c.done + "/" + c.total;
          frac.classList.toggle("is-complete", c.total > 0 && c.done === c.total);
          var durEl = card.querySelector(".dur");
          if (durEl) durEl.textContent = fmtDuration(c.mins, "short");
        });
        phase.querySelectorAll("[data-tier]").forEach(function (tier) {
          var c = count(tier), p = pct(c.done, c.total);
          tier.querySelector("[data-tier-pct]").textContent = p + "%";
          tier.querySelector("[data-tier-bar]").style.width = p + "%";
          var tierHoursEl = tier.querySelector("[data-tier-hours]");
          if (tierHoursEl) tierHoursEl.textContent = fmtDuration(c.mins, "short");
          var tierTotalEl = tier.querySelector("[data-tier-total]");
          if (tierTotalEl) tierTotalEl.textContent = c.total;
        });
        var pc = count(phase), pp = pct(pc.done, pc.total);
        phase.querySelector("[data-phase-pct]").textContent = pp + "%";
        phase.querySelector("[data-phase-bar]").style.width = pp + "%";
        phase.querySelector("[data-phase-count]").textContent =
          pc.done + " of " + pc.total + " done";
        var phaseHoursEl = phase.querySelector("[data-phase-hours]");
        if (phaseHoursEl) phaseHoursEl.textContent = fmtDuration(pc.mins, "long");
        var phaseTotalEl = phase.querySelector("[data-phase-total]");
        if (phaseTotalEl) phaseTotalEl.textContent = pc.total;

        var key = phase.dataset.phase;
        document.getElementById(key + "Pct").textContent = pp + "%";
        document.getElementById(key + "Bar").style.width = pp + "%";
        document.getElementById(key + "Count").textContent =
          pc.done + " of " + pc.total + " done";
        var splitHoursEl = document.querySelector('[data-split-hours="' + key + '"]');
        if (splitHoursEl) splitHoursEl.textContent = fmtDuration(pc.mins, "long");
        var taskTotalEl = document.getElementById(key + "TaskTotal");
        if (taskTotalEl) taskTotalEl.textContent = pc.total;
        var noteTotalEl = document.getElementById(key + "NoteTotal");
        if (noteTotalEl) noteTotalEl.textContent = pc.total;
      });
    }

    boxes.forEach(function (b) {
      b.addEventListener("change", function () {
        render();
        try {
          localStorage.setItem(KEY, JSON.stringify(boxes.map(function (x) { return x.checked; })));
        } catch (e) {}
      });
    });
    document.addEventListener("pde:recalc", render);
    render();
  })();
</script>
